		{ "name": "page-neighborhoods-v1",     "title": "Neighborhoods — Opulent Map Grid",          "postTypes": ["page"] },
		{ "name": "page-neighborhoods-v2",     "title": "Neighborhoods — Pristine Photo Grid",       "postTypes": ["page"] },
		{ "name": "page-neighborhoods-v3",     "title": "Neighborhoods — Vanguard Stats View",       "postTypes": ["page"] },
